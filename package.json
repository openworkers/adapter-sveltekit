{
  "name": "@openworkers/adapter-sveltekit",
  "version": "0.5.0",
  "description": "SvelteKit adapter for OpenWorkers",
  "keywords": [
    "adapter",
    "openworkers",
    "edge",
    "workers",
    "svelte",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openworkers/adapter-sveltekit.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.ts",
    "test": "bun test",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "esbuild": "^0.27.2"
  },
  "devDependencies": {
    "@openworkers/workers-types": "^0.1.9",
    "@sveltejs/kit": "^2.0.0",
    "bun-types": "^1.3.8",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
